{
  "name": "ultimate-bakery-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ultimate Bakery Tracker - premium offline bakery management application",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noCheck && vite build",
    "build:strict": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:sql": "node scripts/check-sql.mjs",
    "check:alias": "node scripts/check-alias.mjs",
    "check:queries": "node scripts/check-queries.mjs",
    "test": "node scripts/check-sql.mjs && node scripts/check-alias.mjs && node scripts/check-queries.mjs",
    "verify": "npm run typecheck && npm test && vite build"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "sql.js": "^1.11.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
